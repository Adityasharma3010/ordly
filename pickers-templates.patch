+  const shown = useRef(false);
+
+  // Put keyboard focus on the focused day (on open, and as the arrows move it).
+  useEffect(() => {
+    dayRefs.current[focus]?.focus();
+  }, [focus, view]);
+
+  // The month slides in from the side it came from.
+  useLayoutEffect(() => {
