@@ -0,0 +1,268 @@
+// Supabase Edge Function: send-invite
+//
+// Sends the "you've been invited to a list" email through Resend. The browser calls it with
+// the signed-in person's login, like this:  supabase.functions.invoke("send-invite", {
+// body: { invite_id } }). It never takes an email address or any text from the browser: it asks
+// the database (invite_email_begin) who the invite is for and which list it is about, and the
+// database only answers if the caller owns that list, has a confirmed email and is within the
+// sending limits. So this can't be used to send mail to arbitrary people or with arbitrary text.
+//
+// Secrets it needs (Supabase Dashboard > Edge Functions > Secrets). SUPABASE_URL and
+// SUPABASE_ANON_KEY are provided automatically; you add the other three:
+//   RESEND_API_KEY   your Resend API key
+//   MAIL_FROM        who the email comes from, e.g.  Ordly <invites@mail.yourdomain.com>
+//   APP_URL          where Ordly lives, e.g.  https://ordly-lists.vercel.app
+// Optional:
+//   ALLOWED_ORIGINS  extra websites allowed to call this, comma separated (previews, etc.)
+//   RESEND_API_URL   only for testing against a pretend email service; leave it unset
+
+// ------------------------------------------------------------------ email text
+
+// Makes text safe to put inside HTML.
+export function esc(s: unknown): string {
+  return String(s ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+// One line, no control characters, not too long (for subjects and names).
+const oneLine = (s: unknown, max: number) =>
+  // deno-lint-ignore no-control-regex
+  String(s ?? "")
+    .replace(/[\u0000-\u001f\u007f\u2028\u2029]+/g, " ")
+    .trim()
+    .slice(0, max);
+
+export type InviteDetails = {
+  inviter: string;
+  listTitle: string;
+  invitee: string;
+  role: string;
+  appUrl: string;
+};
+
+export function buildInviteEmail(d: InviteDetails) {
+  const inviter = oneLine(d.inviter, 60) || "Someone";
+  const title = oneLine(d.listTitle, 100) || "a list";
+  const can = d.role === "editor" ? "edit" : "view";
+  const link = `${d.appUrl.replace(/\/+$/, "")}/login`;
+  const subject = `${inviter} invited you to “${title}” on Ordly`;
+
+  const text = [
+    `${inviter} shared the list “${title}” with you on Ordly. You will be able to ${can} it.`,
+    "",
+    `To open it, sign in (or create an account) with this email address, ${d.invitee}:`,
+    link,
+    "",
+    "The list will appear under “Shared with me”.",
+    "",
+    "If you weren’t expecting this, you can ignore this email. Nothing happens unless you sign in with this address.",
+  ].join("\n");
+
+  const html = `<!doctype html>
+<html><body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1b1f27">
+  <div style="max-width:480px;margin:0 auto;background:#ffffff;border-radius:14px;padding:28px">
+    <p style="margin:0 0 4px;font-size:13px;letter-spacing:.04em;color:#8a6a1f">ORDLY</p>
+    <h1 style="margin:0 0 14px;font-size:20px;line-height:1.3">${esc(inviter)} invited you to “${esc(title)}”</h1>
+    <p style="margin:0 0 18px;font-size:15px;line-height:1.55">You will be able to <b>${can}</b> this list. Sign in (or create an account) with <b>${esc(d.invitee)}</b> and it will appear under “Shared with me”.</p>
+    <p style="margin:0 0 22px"><a href="${esc(link)}" style="display:inline-block;background:#f0b24b;color:#17130a;text-decoration:none;font-weight:600;font-size:15px;padding:11px 20px;border-radius:10px">Open Ordly</a></p>
+    <p style="margin:0;font-size:12px;line-height:1.5;color:#6b7280">If you weren’t expecting this, you can ignore this email. Nothing happens unless you sign in with this address.</p>
+  </div>
+</body></html>`;
+  return { subject, text, html };
+}
+
+// ------------------------------------------------------------------ the request
+
+type Env = { get(key: string): string | undefined };
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+// What the database says when it refuses, and what we answer.
+const REFUSALS: Record<string, [number, string]> = {
+  not_allowed: [403, "not_allowed"],
+  unverified: [403, "unverified"],
+  cooldown: [429, "cooldown"],
+  too_many_for_invite: [429, "too_many_for_invite"],
+  hourly_limit: [429, "hourly_limit"],
+  daily_limit: [429, "daily_limit"],
+};
+
+function corsFor(req: Request, env: Env): Record<string, string> {
+  const origin = req.headers.get("Origin") || "";
+  const allowed = new Set<string>([
+    "http://localhost:5173",
+    "http://127.0.0.1:5173",
+  ]);
+  try {
+    const app = env.get("APP_URL");
+    if (app) allowed.add(new URL(app).origin);
+  } catch {
+    /* APP_URL isn't a web address; reported below */
+  }
+  for (const o of (env.get("ALLOWED_ORIGINS") || "").split(","))
+    if (o.trim()) allowed.add(o.trim());
+  const headers: Record<string, string> = {
+    "Access-Control-Allow-Headers":
+      "authorization, x-client-info, apikey, content-type",
+    "Access-Control-Allow-Methods": "POST, OPTIONS",
+    Vary: "Origin",
+  };
+  if (allowed.has(origin)) headers["Access-Control-Allow-Origin"] = origin;
+  return headers;
+}
+
+export async function handle(
+  req: Request,
+  env: Env,
+  doFetch: typeof fetch,
+): Promise<Response> {
+  const cors = corsFor(req, env);
+  const reply = (status: number, body: Record<string, unknown>) =>
+    new Response(JSON.stringify(body), {
+      status,
+      headers: { ...cors, "Content-Type": "application/json" },
+    });
+
+  if (req.method === "OPTIONS")
+    return new Response(null, { status: 204, headers: cors });
+  if (req.method !== "POST") return reply(405, { error: "method_not_allowed" });
+
+  const auth = req.headers.get("Authorization") || "";
+  if (!/^Bearer\s+\S+$/i.test(auth))
+    return reply(401, { error: "not_signed_in" });
+
+  let inviteId = "";
+  try {
+    const body = await req.json();
+    inviteId = typeof body?.invite_id === "string" ? body.invite_id : "";
+  } catch {
+    /* handled just below */
+  }
+  if (!UUID.test(inviteId)) return reply(400, { error: "bad_request" });
+
+  const cfg = {
+    SUPABASE_URL: env.get("SUPABASE_URL"),
+    SUPABASE_ANON_KEY: env.get("SUPABASE_ANON_KEY"),
+    RESEND_API_KEY: env.get("RESEND_API_KEY"),
+    MAIL_FROM: env.get("MAIL_FROM"),
+    APP_URL: env.get("APP_URL"),
+  };
+  const missing = Object.entries(cfg)
+    .filter(([, v]) => !v)
+    .map(([k]) => k);
+  if (missing.length) return reply(503, { error: "not_configured", missing });
+  if (!/^https?:\/\//i.test(cfg.APP_URL!)) {
+    return reply(503, {
+      error: "not_configured",
+      missing: ["APP_URL (must start with https://)"],
+    });
+  }
+
+  const rpc = (name: string, args: Record<string, unknown>) =>
+    doFetch(`${cfg.SUPABASE_URL!.replace(/\/+$/, "")}/rest/v1/rpc/${name}`, {
+      method: "POST",
+      headers: {
+        apikey: cfg.SUPABASE_ANON_KEY!,
+        Authorization: auth, // the caller's own login: the database decides what they may do
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify(args),
+    });
+
+  // 1. Ask the database whether this invite may be emailed right now, and what it says.
+  let details: {
+    log_id: string;
+    list_title: string;
+    invitee: string;
+    role: string;
+    inviter_name: string;
+  };
+  try {
+    const res = await rpc("invite_email_begin", { p_invite_id: inviteId });
+    const data = await res.json().catch(() => ({}));
+    if (!res.ok) {
+      const msg = String(data?.message || "");
+      if (res.status === 401 || /jwt/i.test(msg))
+        return reply(401, { error: "not_signed_in" });
+      for (const [key, [status, code]] of Object.entries(REFUSALS))
+        if (msg.includes(key)) return reply(status, { error: code });
+      return reply(502, { error: "database_error" });
+    }
+    details = data;
+  } catch {
+    return reply(502, { error: "database_error" });
+  }
+
+  // 2. Send it.
+  const mail = buildInviteEmail({
+    inviter: details.inviter_name,
+    listTitle: details.list_title,
+    invitee: details.invitee,
+    role: details.role,
+    appUrl: cfg.APP_URL!,
+  });
+  let failure: { status: number; message: string } | null = null;
+  try {
+    const res = await doFetch(
+      env.get("RESEND_API_URL") || "https://api.resend.com/emails",
+      {
+        method: "POST",
+        headers: {
+          Authorization: `Bearer ${cfg.RESEND_API_KEY}`,
+          "Content-Type": "application/json",
+          "Idempotency-Key": details.log_id, // a retry of the same send never emails twice
+        },
+        body: JSON.stringify({
+          from: cfg.MAIL_FROM,
+          to: [details.invitee],
+          subject: mail.subject,
+          text: mail.text,
+          html: mail.html,
+        }),
+        signal: AbortSignal.timeout(10_000),
+      },
+    );
+    if (!res.ok) {
+      const data = await res.json().catch(() => ({}));
+      failure = {
+        status: res.status,
+        message: String(data?.message || "").slice(0, 300),
+      };
+    }
+  } catch {
+    failure = { status: 0, message: "Couldn’t reach the email service." };
+  }
+
+  // 3. If the email service said no, give the sending allowance back and say why.
+  if (failure) {
+    try {
+      await rpc("invite_email_undo", { p_log_id: details.log_id });
+    } catch {
+      /* best effort */
+    }
+    return reply(502, {
+      error: "email_failed",
+      provider_status: failure.status,
+      provider_message: failure.message,
+    });
+  }
+
+  return reply(200, {
+    ok: true,
+    sent_to: details.invitee,
+    sent_at: new Date().toISOString(),
+  });
+}
+
+// Start serving when running inside Supabase (the Deno runtime). Skipped when this file is
+// imported by the tests.
+const deno = (
+  globalThis as {
+    Deno?: { serve: (h: (r: Request) => Promise<Response>) => void; env: Env };
+  }
+).Deno;
+if (deno) deno.serve((req) => handle(req, deno.env, fetch));
diff --git a/supabase/invite-emails.sql b/supabase/invite-emails.sql
new file mode 100644
index 0000000..44b1b4f
--- /dev/null
+++ b/supabase/invite-emails.sql
@@ -0,0 +1,108 @@
+-- =====================================================================
+-- Ordly — invite emails (run ONCE on your live Supabase project)
+--
+--   • remembers when each pending invite was last emailed
+--   • invite_email_begin(): the one place that decides whether an invite email may be sent
+--     right now (you own the list, your own email is confirmed, not too often) and hands back
+--     what the email says. The Edge Function "send-invite" calls it before it sends anything.
+--   • invite_email_undo(): takes a send back if the email service failed, so a broken setup
+--     doesn't use up your sending allowance while you fix it
+--
+-- Dashboard → SQL Editor → New query → paste this whole file → Run.
+-- supabase/schema.sql has already been updated to match, so a brand-new project only needs
+-- schema.sql. Safe to run twice; nothing existing changes.
+-- =====================================================================
+
+alter table public.list_invites
+  add column if not exists emailed_at  timestamptz,
+  add column if not exists email_count smallint not null default 0;
+
+-- A private log of sends, used for the limits below. Nobody can read or write it through the
+-- API (RLS on, no policies): only the functions below touch it.
+create table if not exists public.invite_email_log (
+  id               uuid primary key default gen_random_uuid(),
+  owner_id         uuid not null references auth.users (id) on delete cascade,
+  invite_id        uuid references public.list_invites (id) on delete set null,
+  prev_emailed_at  timestamptz,
+  sent_at          timestamptz not null default now()
+);
+alter table public.invite_email_log enable row level security;
+create index if not exists invite_email_log_owner_idx on public.invite_email_log (owner_id, sent_at desc);
+
+-- Limits: 1 minute between emails for the same invite, 5 emails per invite, 20 an hour and
+-- 60 a day per person. Raise them here if you ever need to.
+create or replace function public.invite_email_begin(p_invite_id uuid)
+returns jsonb language plpgsql security definer set search_path = public, auth as $$
+declare
+  uid uuid := auth.uid();
+  inv record;
+  who text;
+  log_id uuid;
+begin
+  if uid is null then raise exception 'not_allowed'; end if;
+
+  select i.id, i.email, i.role, i.emailed_at, i.email_count, l.id as list_id, l.title
+    into inv
+    from public.list_invites i
+    join public.lists l on l.id = i.list_id
+   where i.id = p_invite_id and l.owner_id = uid;
+  if not found then raise exception 'not_allowed'; end if;
+
+  -- Only people with a confirmed email can send, so throwaway accounts can't be used to spam.
+  if not exists (select 1 from auth.users u where u.id = uid and u.email_confirmed_at is not null) then
+    raise exception 'unverified';
+  end if;
+
+  if inv.emailed_at is not null and inv.emailed_at > now() - interval '1 minute' then
+    raise exception 'cooldown';
+  end if;
+  if inv.email_count >= 5 then raise exception 'too_many_for_invite'; end if;
+  if (select count(*) from public.invite_email_log where owner_id = uid and sent_at > now() - interval '1 hour') >= 20 then
+    raise exception 'hourly_limit';
+  end if;
+  if (select count(*) from public.invite_email_log where owner_id = uid and sent_at > now() - interval '1 day') >= 60 then
+    raise exception 'daily_limit';
+  end if;
+
+  select coalesce(nullif(btrim(p.display_name), ''), split_part(u.email, '@', 1))
+    into who
+    from auth.users u
+    left join public.profiles p on p.id = u.id
+   where u.id = uid;
+
+  insert into public.invite_email_log (owner_id, invite_id, prev_emailed_at)
+  values (uid, inv.id, inv.emailed_at)
+  returning id into log_id;
+
+  update public.list_invites
+     set emailed_at = now(), email_count = email_count + 1
+   where id = inv.id;
+
+  return jsonb_build_object(
+    'log_id', log_id,
+    'list_id', inv.list_id,
+    'list_title', inv.title,
+    'invitee', inv.email,
+    'role', inv.role,
+    'inviter_name', who
+  );
+end $$;
+
+create or replace function public.invite_email_undo(p_log_id uuid)
+returns void language plpgsql security definer set search_path = public, auth as $$
+declare
+  uid uuid := auth.uid();
+  entry record;
+begin
+  if uid is null then return; end if;
+  select * into entry from public.invite_email_log where id = p_log_id and owner_id = uid;
+  if not found then return; end if;
+  update public.list_invites
+     set emailed_at = entry.prev_emailed_at,
+         email_count = greatest(email_count - 1, 0)
+   where id = entry.invite_id;
+  delete from public.invite_email_log where id = entry.id;
+end $$;
+
+revoke execute on function public.invite_email_begin(uuid) from public, anon;
+revoke execute on function public.invite_email_undo(uuid)  from public, anon;
