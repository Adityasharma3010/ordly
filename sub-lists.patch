diff --git a/supabase/sub-lists.sql b/supabase/sub-lists.sql
new file mode 100644
index 0000000..336e833
--- /dev/null
+++ b/supabase/sub-lists.sql
@@ -0,0 +1,52 @@
+-- =====================================================================
+-- Ordly — sub-lists (run ONCE on your live Supabase project)
+--
+--   • a list can sit inside another list of YOURS (folder-like), at any depth
+--   • a sub-list keeps its own sharing; nothing is inherited from the parent
+--   • deleting a list deletes the lists inside it
+--   • a list can't be moved inside itself (or one of its own sub-lists)
+--
+-- Dashboard → SQL Editor → New query → paste this whole file → Run.
+-- supabase/schema.sql has already been updated to match, so a brand-new
+-- project only needs schema.sql. Safe to run twice.
+-- =====================================================================
+
+alter table public.lists add column if not exists parent_list_id uuid;
+
+-- (parent_list_id, owner_id) must point at a list with the SAME owner, so nobody can
+-- hang a list under somebody else's. A null parent_list_id means a top-level list,
+-- which is every list you have today.
+do $$ begin
+  if not exists (select 1 from pg_constraint where conname = 'lists_id_owner_key') then
+    alter table public.lists add constraint lists_id_owner_key unique (id, owner_id);
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'lists_parent_fk') then
+    alter table public.lists add constraint lists_parent_fk
+      foreign key (parent_list_id, owner_id) references public.lists (id, owner_id) on delete cascade;
+  end if;
+end $$;
+
+create index if not exists lists_parent_idx on public.lists (parent_list_id);
+
+-- Refuse to move a list underneath itself (or one of its own sub-lists).
+create or replace function public.check_list_parent()
+returns trigger language plpgsql set search_path = public as $$
+begin
+  if new.parent_list_id is null then return new; end if;
+  if new.parent_list_id = new.id or exists (
+    with recursive up as (
+      select id, parent_list_id from public.lists where id = new.parent_list_id
+      union all
+      select l.id, l.parent_list_id from public.lists l join up on l.id = up.parent_list_id
+    )
+    select 1 from up where id = new.id
+  ) then
+    raise exception 'list_cycle' using errcode = '23514';
+  end if;
+  return new;
+end $$;
+revoke execute on function public.check_list_parent() from public, anon, authenticated;
+
+drop trigger if exists lists_check_parent on public.lists;
+create trigger lists_check_parent before update of parent_list_id on public.lists
+  for each row execute function public.check_list_parent();
diff --git a/tests/listTree.test.js b/tests/listTree.test.js
new file mode 100644
index 0000000..70d5a73
--- /dev/null
+++ b/tests/listTree.test.js
@@ -0,0 +1,106 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildListRows,
+  canMoveList,
+  listAncestorIds,
+  listDescendantIds,
+  listSubtreeIds,
+  moveTargets,
+} from "../src/utils/listTree";
+
+const L = (id, parent = null, o = {}) => ({
+  id,
+  title: id,
+  parent_list_id: parent,
+  role: "owner",
+  archived: false,
+  ...o,
+});
+// a ─ b ─ c
+//   └ d
+// e
+const lists = [L("a"), L("b", "a"), L("c", "b"), L("d", "a"), L("e")];
+
+describe("list tree helpers", () => {
+  it("finds everything inside a list, however deep", () => {
+    expect(listDescendantIds(lists, "a").sort()).toEqual(["b", "c", "d"]);
+    expect(listSubtreeIds(lists, "b").sort()).toEqual(["b", "c"]);
+    expect(listDescendantIds(lists, "e")).toEqual([]);
+  });
+
+  it("finds the lists above one, nearest first", () => {
+    expect(listAncestorIds(lists, "c")).toEqual(["b", "a"]);
+    expect(listAncestorIds(lists, "a")).toEqual([]);
+    expect(listAncestorIds(lists, "missing")).toEqual([]);
+  });
+
+  it("won't move a list into itself or into something inside it", () => {
+    expect(canMoveList(lists, "a", "a")).toBe(false);
+    expect(canMoveList(lists, "a", "c")).toBe(false);
+    expect(canMoveList(lists, "b", "a")).toBe(true);
+    expect(canMoveList(lists, "c", null)).toBe(true);
+    expect(canMoveList(lists, "e", "c")).toBe(true);
+  });
+
+  it("builds sidebar rows: parents first, children only when unfolded", () => {
+    const ids = (rows) => rows.map((r) => `${r.depth}:${r.list.id}`);
+    expect(ids(buildListRows(lists, []))).toEqual(["0:a", "0:e"]);
+    expect(ids(buildListRows(lists, ["a"]))).toEqual([
+      "0:a",
+      "1:b",
+      "1:d",
+      "0:e",
+    ]);
+    expect(ids(buildListRows(lists, ["a", "b"]))).toEqual([
+      "0:a",
+      "1:b",
+      "2:c",
+      "1:d",
+      "0:e",
+    ]);
+    const rows = buildListRows(lists, ["a"]);
+    expect(rows[0]).toMatchObject({ hasChildren: true, expanded: true });
+    expect(rows[1]).toMatchObject({ hasChildren: true, expanded: false });
+    expect(rows[2]).toMatchObject({ hasChildren: false });
+  });
+
+  it("flat mode ignores nesting", () => {
+    const rows = buildListRows(lists, ["a"], { flat: true });
+    expect(rows.map((r) => r.list.id)).toEqual(["a", "b", "c", "d", "e"]);
+    expect(rows.every((r) => r.depth === 0)).toBe(true);
+  });
+
+  it("a list whose parent isn't in the set shows at the top level", () => {
+    const some = [L("x", "somebody-elses"), L("y", "x")];
+    expect(buildListRows(some, []).map((r) => r.list.id)).toEqual(["x"]);
+    expect(buildListRows(some, ["x"]).map((r) => r.list.id)).toEqual([
+      "x",
+      "y",
+    ]);
+  });
+
+  it("handles very deep nesting without recursion problems", () => {
+    const deep = [L("n0")];
+    for (let i = 1; i < 5000; i++) deep.push(L(`n${i}`, `n${i - 1}`));
+    expect(listDescendantIds(deep, "n0")).toHaveLength(4999);
+    const rows = buildListRows(
+      deep,
+      deep.map((l) => l.id),
+    );
+    expect(rows).toHaveLength(5000);
+    expect(rows[4999].depth).toBe(4999);
+  });
+
+  it("move targets: only your own, un-archived lists, minus the list itself and what's inside it", () => {
+    const mixed = [
+      ...lists,
+      L("f", null, { archived: true }),
+      L("g", null, { role: "editor" }),
+    ];
+    expect(moveTargets(mixed, "b").map((r) => r.list.id)).toEqual([
+      "a",
+      "d",
+      "e",
+    ]);
+  });
+});
