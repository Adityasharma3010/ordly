# Copy to .env.local and fill in. Both values are safe to expose in the browser:
# the anon key is public by design and every table is protected by Row Level Security.
# NEVER put the service_role key in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
