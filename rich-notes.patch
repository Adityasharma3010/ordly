diff --git a/src/components/notes/Markdown.jsx b/src/components/notes/Markdown.jsx
new file mode 100644
index 0000000..0be4201
--- /dev/null
+++ b/src/components/notes/Markdown.jsx
@@ -0,0 +1,107 @@
+import { Fragment, memo, useMemo } from "react";
+import { parseMarkdown } from "../../utils/markdown";
+
+// Draws a note. The text is turned into a tree of plain data (utils/markdown.js) and every
+// piece becomes a React element: no HTML from the note is ever inserted into the page, so a
+// note can't run code. Links open in a new tab and tell search engines not to trust them.
+function Inline({ nodes }) {
+  return nodes.map((n, i) => {
+    switch (n.t) {
+      case "text":
+        return <Fragment key={i}>{n.v}</Fragment>;
+      case "br":
+        return <br key={i} />;
+      case "b":
+        return (
+          <strong key={i} className="font-semibold text-fg">
+            <Inline nodes={n.c} />
+          </strong>
+        );
+      case "i":
+        return (
+          <em key={i}>
+            <Inline nodes={n.c} />
+          </em>
+        );
+      case "s":
+        return (
+          <del key={i}>
+            <Inline nodes={n.c} />
+          </del>
+        );
+      case "code":
+        return <code key={i}>{n.v}</code>;
+      case "a":
+        return (
+          <a
+            key={i}
+            href={n.href}
+            target="_blank"
+            rel="noopener noreferrer nofollow ugc"
+          >
+            <Inline nodes={n.c} />
+          </a>
+        );
+      default:
+        return null;
+    }
+  });
+}
+
+function Blocks({ blocks }) {
+  return blocks.map((b, i) => {
+    switch (b.t) {
+      case "p":
+        return (
+          <p key={i}>
+            <Inline nodes={b.c} />
+          </p>
+        );
+      case "h": {
+        const Tag = `h${b.level}`;
+        return (
+          <Tag key={i}>
+            <Inline nodes={b.c} />
+          </Tag>
+        );
+      }
+      case "quote":
+        return (
+          <blockquote key={i}>
+            <Blocks blocks={b.c} />
+          </blockquote>
+        );
+      case "code":
+        return (
+          <pre key={i}>
+            <code>{b.v}</code>
+          </pre>
+        );
+      case "hr":
+        return <hr key={i} />;
+      case "list": {
+        const Tag = b.ordered ? "ol" : "ul";
+        return (
+          <Tag key={i} start={b.ordered && b.start !== 1 ? b.start : undefined}>
+            {b.items.map((item, k) => (
+              <li key={k}>
+                <Blocks blocks={item} />
+              </li>
+            ))}
+          </Tag>
+        );
+      }
+      default:
+        return null;
+    }
+  });
+}
+
+export const Markdown = memo(function Markdown({ text, className = "" }) {
+  const blocks = useMemo(() => parseMarkdown(text), [text]);
+  return (
+    <div className={`notes-md ${className}`}>
+      <Blocks blocks={blocks} />
+    </div>
+  );
+});
diff --git a/src/components/notes/NotesEditor.jsx b/src/components/notes/NotesEditor.jsx
new file mode 100644
index 0000000..450c02e
--- /dev/null
+++ b/src/components/notes/NotesEditor.jsx
@@ -0,0 +1,216 @@
+import { lazy, Suspense, useLayoutEffect, useRef, useState } from "react";
+import { Eye, Pencil } from "lucide-react";
+import { Markdown } from "./Markdown";
+import { NotesToolbar } from "./NotesToolbar";
+import { usePersistentState } from "../../hooks/usePersistentState";
+import {
+  continueList,
+  insertLink,
+  toggleLinePrefix,
+  wrapSelection,
+} from "../../utils/mdEdit";
+
+// The rich editor is a big library, so it is only downloaded when someone picks it.
+const RichEditor = lazy(() => import("./RichEditor"));
+
+export const NOTES_LIMIT = 10000;
+
+const MARKS = { bold: "**", italic: "*", strike: "~~", code: "`" };
+
+// Editing a note. The note is always stored as Markdown text; this box offers two ways to
+// write it: the Markdown text itself (with a toolbar that inserts the symbols for you), or a
+// rich editor where you just see bold, lists and links. The choice is remembered.
+export function NotesEditor({ value, onChange, onDone, autoFocus }) {
+  const [mode, setMode] = usePersistentState("ordly.notes.mode", "markdown");
+  const rich = mode === "rich";
+
+  const switcher = (
+    <div
+      role="group"
+      aria-label="Editor"
+      className="flex rounded-md border border-line p-0.5 text-[11px]"
+    >
+      {[
+        ["markdown", "Markdown"],
+        ["rich", "Rich text"],
+      ].map(([key, label]) => (
+        <button
+          key={key}
+          type="button"
+          aria-pressed={mode === key}
+          onMouseDown={(e) => e.preventDefault()}
+          onClick={() => setMode(key)}
+          className={`h-5 cursor-pointer rounded px-1.5 transition-colors ${mode === key ? "bg-accent/20 text-fg" : "text-muted hover:text-fg"}`}
+        >
+          {label}
+        </button>
+      ))}
+    </div>
+  );
+
+  return (
+    <div
+      role="group"
+      aria-label="Notes editor"
+      onKeyDown={(e) => {
+        if (e.key === "Escape") {
+          e.stopPropagation();
+          onDone();
+        }
+      }}
+      className="overflow-hidden rounded-lg border border-line bg-raised focus-within:border-accent"
+    >
+      {rich ? (
+        <Suspense
+          fallback={
+            <>
+              <div className="flex items-center justify-end border-b border-line px-1.5 py-1">
+                {switcher}
+              </div>
+              <p className="px-3 py-3 text-[13px] text-faint" role="status">
+                Loading the rich editor…
+              </p>
+            </>
+          }
+        >
+          <RichEditor
+            value={value}
+            onChange={onChange}
+            autoFocus={autoFocus}
+            extras={switcher}
+          />
+        </Suspense>
+      ) : (
+        <MarkdownPane
+          value={value}
+          onChange={onChange}
+          autoFocus={autoFocus}
+          extras={switcher}
+        />
+      )}
+      <div className="flex items-center justify-between border-t border-line px-2 py-1">
+        <span
+          className={`text-[11px] tabular-nums ${value.length > NOTES_LIMIT - 500 ? "text-danger" : "text-faint"}`}
+        >
+          {value.length > NOTES_LIMIT - 1000
+            ? `${value.length.toLocaleString()} / ${NOTES_LIMIT.toLocaleString()}`
+            : "Saved as you type"}
+        </span>
+        <button
+          type="button"
+          onMouseDown={(e) => e.preventDefault()}
+          onClick={onDone}
+          className="h-6 cursor-pointer rounded-md px-2 text-xs font-medium text-accent-ink transition-colors hover:bg-line/60"
+        >
+          Done
+        </button>
+      </div>
+    </div>
+  );
+}
+
+function MarkdownPane({ value, onChange, autoFocus, extras }) {
+  const ref = useRef(null);
+  const pending = useRef(null); // where the selection goes after the next edit
+  const [preview, setPreview] = useState(false);
+
+  useLayoutEffect(() => {
+    if (autoFocus) ref.current?.focus();
+    // Only when the box first opens.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // After a toolbar edit the text changes, then the selection is put back where we wanted.
+  useLayoutEffect(() => {
+    const ta = ref.current;
+    if (pending.current && ta) {
+      ta.setSelectionRange(pending.current.start, pending.current.end);
+      pending.current = null;
+    }
+  }, [value]);
+
+  const edit = (fn) => {
+    const ta = ref.current;
+    if (!ta) return;
+    const r = fn(ta.value, ta.selectionStart, ta.selectionEnd);
+    if (!r || r.value.length > NOTES_LIMIT) return;
+    pending.current = { start: r.start, end: r.end };
+    if (r.value === ta.value) ta.setSelectionRange(r.start, r.end);
+    else onChange(r.value);
+  };
+
+  const act = (id) => {
+    if (MARKS[id]) edit((v, a, b) => wrapSelection(v, a, b, MARKS[id]));
+    else if (id === "link") edit(insertLink);
+    else edit((v, a, b) => toggleLinePrefix(v, a, b, id));
+  };
+
+  const onKeyDown = (e) => {
+    const mod = e.ctrlKey || e.metaKey;
+    if (mod && !e.shiftKey && !e.altKey) {
+      const id = { b: "bold", i: "italic", k: "link" }[e.key.toLowerCase()];
+      if (id) {
+        e.preventDefault();
+        act(id);
+        return;
+      }
+    }
+    if (e.key === "Enter" && !e.shiftKey && !mod) {
+      const ta = e.currentTarget;
+      if (ta.selectionStart === ta.selectionEnd) {
+        const r = continueList(ta.value, ta.selectionStart);
+        if (r && r.value.length <= NOTES_LIMIT) {
+          e.preventDefault();
+          pending.current = { start: r.start, end: r.end };
+          onChange(r.value);
+        }
+      }
+    }
+  };
+
+  return (
+    <>
+      <div className="flex items-center justify-between gap-2 border-b border-line px-1.5 py-1">
+        <NotesToolbar onAction={act} disabled={preview} />
+        <div className="flex items-center gap-1.5">
+          <button
+            type="button"
+            aria-pressed={preview}
+            onMouseDown={(e) => e.preventDefault()}
+            onClick={() => setPreview((v) => !v)}
+            className="inline-flex h-6 cursor-pointer items-center gap-1 rounded-md px-1.5 text-[11px] text-muted transition-colors hover:bg-line/60 hover:text-fg"
+          >
+            {preview ? (
+              <Pencil className="size-3" aria-hidden />
+            ) : (
+              <Eye className="size-3" aria-hidden />
+            )}
+            {preview ? "Edit" : "Preview"}
+          </button>
+          {extras}
+        </div>
+      </div>
+      {preview ? (
+        <div className="min-h-18 px-3 py-2 text-muted">
+          {value.trim() ? (
+            <Markdown text={value} />
+          ) : (
+            <p className="text-[13px] text-faint">Nothing to preview yet.</p>
+          )}
+        </div>
+      ) : (
+        <textarea
+          ref={ref}
+          value={value}
+          rows={4}
+          maxLength={NOTES_LIMIT}
+          aria-label="Item notes"
+          placeholder="Add details… (Markdown works: **bold**, - lists, [links](https://…))"
+          onChange={(e) => onChange(e.target.value)}
+          onKeyDown={onKeyDown}
+          className="block w-full resize-y bg-transparent px-3 py-2 text-[13px] leading-relaxed text-fg placeholder:text-faint focus:outline-none"
+        />
+      )}
+    </>
+  );
+}
diff --git a/src/components/notes/NotesToolbar.jsx b/src/components/notes/NotesToolbar.jsx
new file mode 100644
index 0000000..26cc935
--- /dev/null
+++ b/src/components/notes/NotesToolbar.jsx
@@ -0,0 +1,49 @@
+import {
+  Bold,
+  Code,
+  Italic,
+  Link2,
+  List,
+  ListOrdered,
+  Quote,
+  Strikethrough,
+} from "lucide-react";
+
+export const TOOLS = [
+  { id: "bold", label: "Bold", Icon: Bold, keys: "Ctrl+B" },
+  { id: "italic", label: "Italic", Icon: Italic, keys: "Ctrl+I" },
+  { id: "strike", label: "Strikethrough", Icon: Strikethrough },
+  { id: "code", label: "Code", Icon: Code },
+  { id: "link", label: "Link", Icon: Link2, keys: "Ctrl+K" },
+  { id: "ul", label: "Bulleted list", Icon: List },
+  { id: "ol", label: "Numbered list", Icon: ListOrdered },
+  { id: "quote", label: "Quote", Icon: Quote },
+];
+
+// The row of formatting buttons, shared by the Markdown box and the rich editor. Clicking a
+// button must not steal focus from the text, hence the mouse-down guard.
+export function NotesToolbar({ onAction, active, disabled }) {
+  return (
+    <div
+      role="toolbar"
+      aria-label="Formatting"
+      className="flex flex-wrap items-center gap-0.5"
+    >
+      {TOOLS.map(({ id, label, Icon, keys }) => (
+        <button
+          key={id}
+          type="button"
+          disabled={disabled}
+          aria-label={label}
+          aria-pressed={active ? !!active[id] : undefined}
+          title={keys ? `${label} (${keys})` : label}
+          onMouseDown={(e) => e.preventDefault()}
+          onClick={() => onAction(id)}
+          className={`grid size-7 cursor-pointer place-items-center rounded-md transition-colors disabled:cursor-default disabled:opacity-40 ${active?.[id] ? "bg-accent/20 text-fg" : "text-muted hover:bg-line/60 hover:text-fg disabled:hover:bg-transparent"}`}
+        >
+          <Icon className="size-3.5" aria-hidden />
+        </button>
+      ))}
+    </div>
+  );
+}
diff --git a/src/components/notes/RichEditor.jsx b/src/components/notes/RichEditor.jsx
new file mode 100644
index 0000000..1f14001
--- /dev/null
+++ b/src/components/notes/RichEditor.jsx
@@ -0,0 +1,191 @@
+import { useEffect, useRef, useState } from "react";
+import { EditorContent, useEditor, useEditorState } from "@tiptap/react";
+import StarterKit from "@tiptap/starter-kit";
+import { Markdown } from "@tiptap/markdown";
+import { Placeholder } from "@tiptap/extensions";
+import { NotesToolbar } from "./NotesToolbar";
+import { safeHref } from "../../utils/markdown";
+
+const LIMIT = 10000;
+
+// The rich note editor (loaded on demand). It reads and writes the very same Markdown text
+// the other editor does, so you can switch between them at any time. Only the kinds of
+// formatting the finished note can show are switched on: bold, italic, strike, code, links,
+// lists, quotes, code blocks and three heading sizes.
+export default function RichEditor({ value, onChange, autoFocus, extras }) {
+  const lastSent = useRef(value); // the text we last handed to the parent
+  const [tooLong, setTooLong] = useState(false);
+  const [linkOpen, setLinkOpen] = useState(false);
+  const [href, setHref] = useState("");
+  const [linkError, setLinkError] = useState("");
+
+  const editor = useEditor({
+    extensions: [
+      StarterKit.configure({
+        underline: false, // no Markdown for it
+        horizontalRule: false,
+        heading: { levels: [1, 2, 3] },
+        link: {
+          openOnClick: false,
+          autolink: true,
+          linkOnPaste: true,
+          // Only web and mail addresses, like the finished note.
+          isAllowedUri: (url) => !!safeHref(url),
+          HTMLAttributes: {
+            rel: "noopener noreferrer nofollow ugc",
+            target: "_blank",
+          },
+        },
+      }),
+      Markdown.configure({ markedOptions: { gfm: true, breaks: true } }),
+      Placeholder.configure({ placeholder: "Add details…" }),
+    ],
+    content: value || "",
+    contentType: "markdown",
+    autofocus: autoFocus ? "end" : false,
+    editorProps: {
+      attributes: {
+        role: "textbox",
+        "aria-multiline": "true",
+        "aria-label": "Item notes",
+      },
+    },
+    onUpdate: ({ editor: ed }) => {
+      const md = ed.getMarkdown();
+      lastSent.current = md;
+      if (md.length > LIMIT) {
+        setTooLong(true); // not saved until it is short enough again
+        return;
+      }
+      setTooLong(false);
+      onChange(md);
+    },
+  });
+
+  // Changes that come from outside (another person editing, Undo) while you aren't typing.
+  useEffect(() => {
+    if (!editor || editor.isFocused || value === lastSent.current) return;
+    lastSent.current = value;
+    editor.commands.setContent(value || "", {
+      contentType: "markdown",
+      emitUpdate: false,
+    });
+  }, [editor, value]);
+
+  const active = useEditorState({
+    editor,
+    selector: ({ editor: ed }) =>
+      ed
+        ? {
+            bold: ed.isActive("bold"),
+            italic: ed.isActive("italic"),
+            strike: ed.isActive("strike"),
+            code: ed.isActive("code"),
+            link: ed.isActive("link"),
+            ul: ed.isActive("bulletList"),
+            ol: ed.isActive("orderedList"),
+            quote: ed.isActive("blockquote"),
+          }
+        : {},
+  });
+
+  const act = (id) => {
+    if (!editor) return;
+    const chain = editor.chain().focus();
+    switch (id) {
+      case "bold":
+        return chain.toggleBold().run();
+      case "italic":
+        return chain.toggleItalic().run();
+      case "strike":
+        return chain.toggleStrike().run();
+      case "code":
+        return chain.toggleCode().run();
+      case "ul":
+        return chain.toggleBulletList().run();
+      case "ol":
+        return chain.toggleOrderedList().run();
+      case "quote":
+        return chain.toggleBlockquote().run();
+      case "link":
+        setHref(editor.getAttributes("link").href || "");
+        setLinkError("");
+        return setLinkOpen((v) => !v);
+    }
+  };
+
+  const applyLink = () => {
+    const safe = safeHref(href);
+    if (!href.trim()) {
+      editor.chain().focus().extendMarkRange("link").unsetLink().run();
+    } else if (!safe) {
+      setLinkError("Use a web address like https://example.com");
+      return;
+    } else {
+      editor
+        .chain()
+        .focus()
+        .extendMarkRange("link")
+        .setLink({ href: safe })
+        .run();
+    }
+    setLinkOpen(false);
+  };
+
+  return (
+    <>
+      <div className="flex items-center justify-between gap-2 border-b border-line px-1.5 py-1">
+        <NotesToolbar onAction={act} active={active} disabled={!editor} />
+        {extras}
+      </div>
+      {linkOpen && (
+        <div className="flex flex-wrap items-center gap-1.5 border-b border-line px-2 py-1.5">
+          <input
+            autoFocus
+            aria-label="Link address"
+            aria-invalid={!!linkError}
+            value={href}
+            placeholder="https://example.com"
+            onChange={(e) => {
+              setHref(e.target.value);
+              setLinkError("");
+            }}
+            onKeyDown={(e) => {
+              if (e.key === "Enter") {
+                e.preventDefault();
+                applyLink();
+              } else if (e.key === "Escape") {
+                e.stopPropagation();
+                setLinkOpen(false);
+                editor?.commands.focus();
+              }
+            }}
+            className="h-7 min-w-40 flex-1 rounded-md border border-line bg-surface px-2 text-[13px] text-fg placeholder:text-faint focus:border-accent focus:outline-none aria-[invalid=true]:border-danger"
+          />
+          <button
+            type="button"
+            onClick={applyLink}
+            className="h-7 cursor-pointer rounded-md border border-line px-2.5 text-xs text-fg transition-colors hover:border-line-strong"
+          >
+            {href.trim() ? "Apply" : "Remove link"}
+          </button>
+          {linkError && (
+            <p role="alert" className="basis-full text-xs text-danger">
+              {linkError}
+            </p>
+          )}
+        </div>
+      )}
+      <EditorContent editor={editor} className="notes-rich" />
+      {tooLong && (
+        <p
+          role="alert"
+          className="border-t border-line px-3 py-1.5 text-xs text-danger"
+        >
+          This note is over {LIMIT.toLocaleString()} characters, so the latest
+          changes aren’t being saved. Shorten it a little.
+        </p>
+      )}
+    </>
+  );
+}
