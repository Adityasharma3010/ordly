diff --git a/src/components/ui/MetaChips.jsx b/src/components/ui/MetaChips.jsx
new file mode 100644
index 0000000..1f468fd
--- /dev/null
+++ b/src/components/ui/MetaChips.jsx
@@ -0,0 +1,64 @@
+import { CalendarDays, Flag } from "lucide-react";
+import { dueState, formatDue } from "../../utils/due";
+import { priorityLabel } from "../../utils/meta";
+
+const dueTone = {
+  overdue: "border-danger/50 bg-danger/10 text-danger",
+  today: "border-accent/50 bg-accent/10 text-accent-ink",
+  soon: "border-line-strong text-fg",
+  later: "border-line text-muted",
+  done: "border-line text-faint",
+};
+const priorityTone = {
+  1: "border-line text-muted",
+  2: "border-accent/40 text-accent-ink",
+  3: "border-danger/50 bg-danger/10 text-danger",
+};
+const chip =
+  "inline-flex h-5 items-center gap-1 rounded-full border px-2 text-[11px] leading-none whitespace-nowrap";
+
+// A due date as a small pill: red when overdue, accent when due today.
+export function DueChip({ source, done = false, now }) {
+  const state = dueState(source, { now, done });
+  if (!state) return null;
+  const spoken = { overdue: "Overdue: ", done: "Was due: " }[state] ?? "Due: ";
+  return (
+    <span className={`${chip} ${dueTone[state]}`} data-due={state}>
+      <CalendarDays className="size-3" aria-hidden />
+      <span className="sr-only">{spoken}</span>
+      {formatDue(source, now)}
+    </span>
+  );
+}
+
+export function PriorityChip({ priority }) {
+  if (!priority) return null;
+  return (
+    <span className={`${chip} ${priorityTone[priority]}`}>
+      <Flag className="size-3" aria-hidden />
+      <span className="sr-only">Priority: </span>
+      {priorityLabel(priority)}
+    </span>
+  );
+}
+
+// Tags as pills. With `onPick` they are buttons (used to filter by that tag).
+export function TagChips({ tags = [], onPick }) {
+  return tags.map((t) =>
+    onPick ? (
+      <button
+        key={t}
+        type="button"
+        onClick={() => onPick(t)}
+        title={`Show only #${t}`}
+        className={`${chip} cursor-pointer border-line text-muted transition-colors hover:border-line-strong hover:text-fg`}
+      >
+        #{t}
+      </button>
+    ) : (
+      <span key={t} className={`${chip} border-line text-muted`}>
+        #{t}
+      </span>
+    ),
+  );
+}
diff --git a/src/components/ui/MetaFields.jsx b/src/components/ui/MetaFields.jsx
new file mode 100644
index 0000000..6cf4a8f
--- /dev/null
+++ b/src/components/ui/MetaFields.jsx
@@ -0,0 +1,148 @@
+import { useId, useState } from "react";
+import { X } from "lucide-react";
+import { addTags, PRIORITIES, removeTag, MAX_TAGS } from "../../utils/meta";
+import { cleanTime } from "../../utils/due";
+
+const field =
+  "h-9 rounded-lg border border-line bg-raised px-3 text-sm text-fg focus:border-accent focus:outline-none disabled:opacity-50";
+
+/**
+ * Due date (+ optional time), priority and tags: the same fields for a list and for an item.
+ * `value` is { due_date, due_time, priority, tags }; `onChange` gets just what changed.
+ * `suggestions` are tags already used elsewhere, offered as you type.
+ */
+export function MetaFields({ value, onChange, suggestions = [] }) {
+  const id = useId();
+  const [draft, setDraft] = useState("");
+  const tags = value.tags || [];
+
+  const commitTag = (raw = draft) => {
+    const next = addTags(tags, raw);
+    if (next.length !== tags.length) onChange({ tags: next });
+    setDraft("");
+  };
+
+  return (
+    <div className="space-y-4">
+      <div className="flex flex-wrap items-end gap-3">
+        <label className="block">
+          <span className="mb-1.5 block text-[13px] font-medium text-muted">
+            Due date
+          </span>
+          <input
+            type="date"
+            value={value.due_date || ""}
+            onChange={(e) =>
+              onChange(
+                e.target.value
+                  ? { due_date: e.target.value }
+                  : { due_date: null, due_time: null },
+              )
+            }
+            className={field}
+          />
+        </label>
+        <label className="block">
+          <span className="mb-1.5 block text-[13px] font-medium text-muted">
+            Time (optional)
+          </span>
+          <input
+            type="time"
+            value={cleanTime(value.due_time) || ""}
+            disabled={!value.due_date}
+            onChange={(e) => onChange({ due_time: e.target.value || null })}
+            className={field}
+          />
+        </label>
+        {value.due_date && (
+          <button
+            type="button"
+            onClick={() => onChange({ due_date: null, due_time: null })}
+            className="mb-1 h-7 cursor-pointer rounded-md px-2 text-[13px] text-muted transition-colors hover:bg-raised hover:text-fg"
+          >
+            Clear due date
+          </button>
+        )}
+      </div>
+
+      <fieldset>
+        <legend className="mb-1.5 text-[13px] font-medium text-muted">
+          Priority
+        </legend>
+        <div className="flex flex-wrap gap-1.5">
+          {PRIORITIES.map((p) => (
+            <button
+              key={p.value}
+              type="button"
+              aria-pressed={(value.priority || 0) === p.value}
+              onClick={() => onChange({ priority: p.value })}
+              className={`h-8 cursor-pointer rounded-lg border px-3 text-[13px] transition-colors ${(value.priority || 0) === p.value ? "border-accent bg-accent/15 text-fg" : "border-line bg-raised text-muted hover:border-line-strong hover:text-fg"}`}
+            >
+              {p.label}
+            </button>
+          ))}
+        </div>
+      </fieldset>
+
+      <div>
+        <label
+          htmlFor={`${id}-tag`}
+          className="mb-1.5 block text-[13px] font-medium text-muted"
+        >
+          Tags
+        </label>
+        <div className="flex min-h-9 flex-wrap items-center gap-1.5 rounded-lg border border-line bg-raised p-1.5 focus-within:border-accent">
+          {tags.map((t) => (
+            <span
+              key={t}
+              className="inline-flex h-6 items-center gap-1 rounded-full border border-line pr-1 pl-2.5 text-xs text-fg"
+            >
+              #{t}
+              <button
+                type="button"
+                aria-label={`Remove tag ${t}`}
+                onClick={() => onChange({ tags: removeTag(tags, t) })}
+                className="grid size-4 cursor-pointer place-items-center rounded-full text-faint hover:text-fg"
+              >
+                <X className="size-3" aria-hidden />
+              </button>
+            </span>
+          ))}
+          <input
+            id={`${id}-tag`}
+            list={`${id}-suggest`}
+            value={draft}
+            disabled={tags.length >= MAX_TAGS}
+            onChange={(e) => {
+              const v = e.target.value;
+              // A comma finishes the tag, so "home, urgent" makes two.
+              if (v.includes(",")) commitTag(v);
+              else setDraft(v);
+            }}
+            onKeyDown={(e) => {
+              if (e.key === "Enter") {
+                e.preventDefault(); // don't submit the form around this field
+                commitTag();
+              }
+              if (e.key === "Backspace" && !draft && tags.length)
+                onChange({ tags: tags.slice(0, -1) });
+            }}
+            onBlur={() => draft && commitTag()}
+            maxLength={40}
+            autoComplete="off"
+            placeholder={tags.length ? "" : "Type a tag and press Enter"}
+            className="min-w-24 flex-1 bg-transparent px-1.5 text-sm placeholder:text-faint focus:outline-none"
+          />
+          <datalist id={`${id}-suggest`}>
+            {suggestions
+              .filter((t) => !tags.includes(t))
+              .slice(0, 12)
+              .map((t) => (
+                <option key={t} value={t} />
+              ))}
+          </datalist>
+        </div>
+      </div>
+    </div>
+  );
+}
